# ─────────────────────────────────────────────────────────────
# SecureFlow — .gitignore
# ─────────────────────────────────────────────────────────────

# ── Dependencies ──────────────────────────────────────────────
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz

# ── Next.js ───────────────────────────────────────────────────
.next/
/out/
next-env.d.ts

# ── Production build ──────────────────────────────────────────
/build
dist/

# ── Environment files (NEVER commit these) ────────────────────
.env
.env.*
!.env.example

# ── Vercel ────────────────────────────────────────────────────
.vercel

# ── Terraform ─────────────────────────────────────────────────
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/terraform.tfstate
terraform/terraform.tfstate.backup
terraform/terraform.tfvars
terraform/*.tfvars
!terraform/terraform.tfvars.example
.terraform/
*.tfplan
*.tfstate
*.tfstate.backup

# ── Docker ────────────────────────────────────────────────────
.docker/

# ── Security scan reports (generated artifacts) ───────────────
*.sarif
report_*.html
report_*.json
npm-audit-report.json
tfsec-report.json
checkov-results.*
trivy-results.*
zap-report.*
dependency-check-report/
reports/

# ── Logs ──────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
/tmp/

# ── OS files ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── IDE / Editor ──────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ── Certificates and keys ─────────────────────────────────────
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
id_rsa
id_rsa.pub
*.ppk

# ── Drizzle ORM generated migrations ──────────────────────────
drizzle/

# ── Testing ───────────────────────────────────────────────────
/coverage
.nyc_output/

# ── Misc ──────────────────────────────────────────────────────
*.tgz
.cache/
