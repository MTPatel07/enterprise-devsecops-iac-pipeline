# ─────────────────────────────────────────────────────────────
# SecureFlow — Environment Variables Template
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# ⚠️  NEVER commit .env to git. It is already in .gitignore.
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
# Local development (Docker Compose)
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/app_db

# ── Docker Compose (local dev) ────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=app_db

# ── App ───────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── CI/CD Secrets (set in GitHub Actions → Settings → Secrets) ─
# These are NOT set here — configure them as GitHub Secrets:
#   SONAR_TOKEN       = SonarQube/SonarCloud token
#   SONAR_HOST_URL    = https://sonarcloud.io
#   SNYK_TOKEN        = Snyk API token
#   AWS_ACCESS_KEY_ID = AWS credentials (for Terraform)
#   AWS_SECRET_ACCESS_KEY = AWS credentials (for Terraform)

# ── Terraform (optional, for AWS deployment) ──────────────────
# TF_VAR_db_username=dbadmin
# TF_VAR_db_password=CHANGE_ME_STRONG_PASSWORD
